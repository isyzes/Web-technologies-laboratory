@if(User.Identity.IsAuthenticated)
{
	<div class="dropdown ms-auto">
		<a class="btn btn-secondary dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
			@User.Identity.Name
			<img src="Image/GetAvatar" width="30" alt="User" class="rounded nav-color" />
		</a>
		<ul class="dropdown-menu">
			<li>
				<span class="dropdown-item-text">
					<img src="Image/GetAvatar" width="50" alt="User" class="rounded" />
					@User.Identity.Name
				</span>
			</li>
			<li><hr class="dropdown-divider"></li>
			<li class="ms-3">
				<form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout">
					<button id="logout" type="submit" class="nav-link btn btn-link nav-color">Logout</button>
				</form>
			</li>
		</ul>
	</div>
}
else
{
	<ul class="navbar-nav">
		<li class="nav-item">
			<a class="nav-link nav-collor" asp-area="Identity" asp-page="/Account/Register">Register</a>
		</li>
		<li class="nav-item">
			<a class="nav-link nav-collor" asp-area="Identity" asp-page="/Account/Login">Login</a>
		</li>
	</ul>
}