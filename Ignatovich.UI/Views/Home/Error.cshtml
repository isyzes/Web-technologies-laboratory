@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="text-center py-5">
    <h1 class="text-danger mb-3">Что-то пошло не так</h1>
    <p class="lead text-muted mb-4">
        При обработке запроса произошла ошибка. Попробуйте обновить страницу или вернуться позже.
    </p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">На главную</a>
    <a class="btn btn-outline-secondary ms-2" asp-controller="Product" asp-action="Index">В каталог</a>
</div>
