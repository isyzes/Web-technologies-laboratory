@page
@model Ignatovich.UI.Areas.Admin.Pages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Book</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="Book.Id" />
            <div class="form-group">
                <label asp-for="Book.Title" class="control-label"></label>
                <input asp-for="Book.Title" class="form-control" />
                <span asp-validation-for="Book.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Book.AuthorId" class="control-label"></label>
                <select asp-for="Book.AuthorId" class="form-control" asp-items="ViewBag.AuthorId" ></select>
                <span asp-validation-for="Book.AuthorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Book.Image" class="control-label">Ссылка на изображение</label>
                <input asp-for="Book.Image" class="form-control" />
                <span asp-validation-for="Book.Image" class="text-danger"></span>
                @if (!string.IsNullOrEmpty(Model.Book.Image))
                {
                    <img src="@Model.Book.Image" alt="@Model.Book.Title" class="img-thumbnail mt-2" style="max-height: 120px;" />
                }
            </div>
            <div class="form-group">
                <label asp-for="ImageFile" class="control-label">Или загрузить новый файл</label>
                <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Book.Rating" class="control-label"></label>
                <input asp-for="Book.Rating" type="number" step="0.01" min="0" max="5" class="form-control" aria-required="true"/>
                <span asp-validation-for="Book.Rating" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

