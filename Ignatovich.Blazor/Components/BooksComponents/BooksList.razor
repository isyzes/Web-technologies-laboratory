@implements IDisposable
@rendermode InteractiveServer

<div class="books-list">
    @if (ProductService.Products != null && ProductService.Products.Any())
    {
        <div class="table-responsive books-list__table-wrapper">
            <table class="table books-list__table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ProductService.Products)
                    {
                        <tr>
                            <td class="books-list__title">@item.Title</td>
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-primary books-list__btn"
                                        @onclick="@(() => OnBookSelected(item.Id))">
                                    Details
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="books-list__empty">
            <p>No books available.</p>
        </div>
    }
</div>

@code {
	[CascadingParameter]
	public IProductService<Book> ProductService { get; set; }

	[Parameter]
	public EventCallback<int> BookSelected { get; set; }

	protected override async Task OnInitializedAsync()
	{
		ProductService.ListChanged += StateHasChanged;
	}

	public async void OnBookSelected(int id)
	{
		await BookSelected.InvokeAsync(id);
	}

	public void Dispose()
	{
		ProductService.ListChanged -= StateHasChanged;
	}

}
