@inject IAuthorService AuthorService

<div class="book-details">
    @if (Book != null)
    {
        <div class="book-details__card card">
            <div class="book-details__image-wrapper">
                <img src="@Book.Image" class="book-details__image" alt="@Book.Title cover">
            </div>
            <div class="card-body book-details__body">
                <span class="book-details__label">Selected Book</span>
                <h5 class="card-title book-details__title">@Book.Title</h5>
                <div class="book-details__rating">
                    <span class="book-details__rating-label">Rating</span>
                    <span class="book-details__rating-value">@Book.Rating</span>
                </div>
                @if (Author != null)
                {
                    <div class="book-details__author">
                        <span class="book-details__author-label">Author</span>
                        <span class="badge book-details__author-badge">@Author.FirstName @Author.LastName</span>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="book-details__placeholder">
            <div class="book-details__placeholder-icon" aria-hidden="true"></div>
            <p>Select a book to view details</p>
        </div>
    }
</div>

@code {
	[Parameter]
	public Book Book { get; set; }
	[Parameter]
	public EventCallback BookChanged { get; set; }

	Author? Author { get; set; }

	protected override async Task OnParametersSetAsync()
	{
		Author = null;
		if (Book != null)
		{
			Author = await AuthorService.GetAuthorAsync(Book.AuthorId);
		}
	}
}
